        <item name="android:windowBackground">@color/logo_background</item>
        <item name="android:windowSplashScreenBackground">@color/logo_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@mipmap/logo_splash_foreground</item>
    </style>
</resources>
